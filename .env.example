# Non-secret tunnel identifier; needed only with the tunnel Compose profile.
CONTROL_PLANE_TUNNEL_ID=
# Put the restricted runtime key in .secrets/openai_tunnel_key, never here.

# Backend host development; leave all three blank for legacy backend-only use.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
WEB_ORIGINS=
# Default Compose Auth URL (e.g. a hosted project). Local Auth uses compose.local-auth.yaml.
SUPABASE_DOCKER_URL=
# Public, frontend build-time values (the browser uses the host-facing URLs).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_FINSIGHT_API_URL=
# Optional host backend port; use 4001 alongside an existing FinSight instance.
FINSIGHT_PORT=4000
